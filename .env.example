# =============================================================================
# Celaest English Front - Environment Variables
# Copy this file to `.env.local` and adjust values. `.env.local` is gitignored.
# =============================================================================

# Backend REST API base URL (no trailing slash)
VITE_API_URL=http://localhost:8080/api/v1

# CELAEST-CORE IA-Mesh base URL used for AI chat evaluation and Whisper
# transcription (no trailing slash). Only two paths are consumed:
#   {VITE_CORE_AI_URL}/ai/chat/simple
#   {VITE_CORE_AI_URL}/ai/audio/transcribe
VITE_CORE_AI_URL=http://127.0.0.1:8085/api/v1

# Notes:
# - The Content-Security-Policy injected at build time derives its
#   `connect-src` origins from these two variables, so keep them accurate.
# - Provider API keys (OpenAI/Anthropic/Gemini/DeepSeek) are entered by the
#   user in Settings and stored encrypted in localStorage; they never reach
#   the backend or any VITE_* variable.
